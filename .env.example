# Critter — API credentials
# Copy to .env and fill in ONE backend.

# ─── Option A: SiliconFlow / OpenAI-compatible (国内推荐) ──────────────────
# 获取 key: https://cloud.siliconflow.cn/ (有免费额度)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen3-32B

# ─── Option B: Anthropic (海外) ────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Optional: local data directory ──────────────────────────────────────
# Unset: keep using ~/.desktop-pet-state.json (existing data stays in place).
# Set an absolute directory or ~/... to use <directory>/state.json instead.
# An explicit shell CRITTER_DATA_DIR takes precedence over this file.
# Existing data is not copied automatically; see README before moving it.
# CRITTER_DATA_DIR="/absolute/path/to/critter-data"
